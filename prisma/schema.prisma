generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── UNTERNEHMEN (ZENTRALE ENTITÄT) ──────────────────────────────

model Unternehmen {
  id                String              @id @default(cuid())

  // Stammdaten
  firmenname        String
  land              Land
  standort          String
  website           String?
  linkedin          String?
  branche           String?
  groesse           UnternehmenGroesse?

  // Ansprechpartner
  ansprechpartner   String
  email             String              @unique
  telefon           String?

  // Kommunikation
  sprachen          Sprache[]
  kurzbeschreibung  String?
  profil            String?

  // ── KULTUR & ZUSAMMENARBEIT (unternehmensbezogen) ────────────
  kulturprofil        String?       // allg. Kulturbeschreibung
  arbeitsweise        String?       // wie arbeiten sie?
  kommunikationsstil  KommunikationStil?
  bevorzugteSprache   Sprache?
  funFactStandard     String?       // generelle FunFact-Antwort des Unternehmens
  persoenlicheNotiz   String?       // Operator-Beobachtung zur Person/Firma

  // Easy-B2B Netzwerkstatus
  netzwerkStatus    NetzwerkStatus      @default(interessiert)
  erstkontakt       DateTime?
  letzteAktivitaet  DateTime?
  interneNotiz      String?

  // ── VERIFIZIERUNG ────────────────────────────────────────────
  verifizierungsStatus  VerifizierungsStatus @default(ungeprueft)
  verifiziertAm         DateTime?
  verifiziertDurch      String?            // Operator-Name
  verifizierungsNotiz   String?

  // ── VERTRAUENS-SCORE (intern, nicht öffentlich) ──────────────
  vertrauensScore       Int                @default(0)
  vertrauensLevel       VertrauensLevel    @default(niedrig)

  // Vertrauensfaktoren (Checkboxen für Operatoren)
  persoenlichesGespraech Boolean           @default(false)
  websiteGeprueft        Boolean           @default(false)
  linkedinGeprueft       Boolean           @default(false)
  empfehlungVorhanden    Boolean           @default(false)
  negativeHinweise       Boolean           @default(false)
  spamRisiko             Boolean           @default(false)

  // Beziehungen
  anfragen            Anfrage[]
  interessentenRollen Interessent[]
  successStories      SuccessStory[]
  eventTeilnahmen     EventTeilnahme[]       // altes Modell, bleibt
  eventTeilnehmer     EventTeilnehmer[]      @relation("EventTeilnehmerU")
  eventFeedbacks      EventFeedback[]        @relation("EventFeedbackU")
  empfohlenDurch      Empfehlung[]           @relation("EmpfehlungUnternehmen")

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

enum Land {
  deutschland
  daenemark
  andere
}

enum UnternehmenGroesse {
  solo          // 1 Person
  klein         // 2–10
  mittel        // 11–50
  gross         // 51–250
  konzern       // 250+
}

enum VerifizierungsStatus {
  ungeprueft      // Neu, noch kein Kontakt
  in_pruefung     // Operator hat Prüfung gestartet
  verifiziert     // Geprüft und freigegeben
  eingeschraenkt  // Teilweise freigegeben, Vorsicht geboten
  abgelehnt       // Nicht akzeptiert
}

enum VertrauensLevel {
  niedrig    //  0–30
  mittel     // 31–60
  hoch       // 61–80
  sehr_hoch  // 81–100
}

enum NetzwerkStatus {
  interessiert
  aktiv
  partner
  pausiert
  inaktiv
}

enum KommunikationStil {
  direkt_informell    // dänisch-typisch
  strukturiert_formal // deutsch-typisch
  offen_herzlich
  zurueckhaltend
  digital_bevorzugt
  persoenlich_bevorzugt
}

// ─── EVENTS ──────────────────────────────────────────────────────

model Event {
  id                String            @id @default(cuid())

  // Grunddaten
  titel             String
  untertitel        String?
  beschreibung      String
  typ               EventTypNeu
  datum             DateTime
  uhrzeit           String?           // z.B. "16:00 – 20:00 Uhr"
  ort               String?
  land              Land
  veranstalter      String            @default("Easy-B2B")

  // Status & Kapazität
  status            EventStatus       @default(geplant)
  maxTeilnehmer     Int?
  sprache           EventSprache      @default(bilingual)

  // Ziele (als String-Array, flexibel)
  ziele             EventZiel[]

  // Beziehungen
  teilnehmer        EventTeilnehmer[]
  feedback          EventFeedback[]
  eventMatches      EventMatch[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model EventTeilnehmer {
  id              String              @id @default(cuid())
  event           Event               @relation(fields: [eventId], references: [id])
  eventId         String

  // Optional: Verknüpfung mit Unternehmen
  unternehmen     Unternehmen?        @relation("EventTeilnehmerU", fields: [unternehmenId], references: [id])
  unternehmenId   String?

  // Fallback-Felder (falls kein Unternehmen-Datensatz)
  firmenname      String
  ansprechpartner String
  email           String
  telefon         String?

  // Teilnahme-Details
  status          TeilnehmerStatus    @default(angemeldet)
  warteliste      Boolean             @default(false)
  rolle           String?             // "Pitcher", "Gast", "Moderator"
  land            Land?
  notiz           String?
  angemeldetAm    DateTime            @default(now())

  // Nach dem Event
  erschienen      Boolean             @default(false)
  feedbackGegeben Boolean             @default(false)

  createdAt       DateTime            @default(now())
}

model EventFeedback {
  id                    String      @id @default(cuid())
  event                 Event       @relation(fields: [eventId], references: [id])
  eventId               String

  unternehmen           Unternehmen? @relation("EventFeedbackU", fields: [unternehmenId], references: [id])
  unternehmenId         String?
  firmenname            String      // Fallback

  // Bewertung
  bewertung             Int         // 1–5
  wiederTeilnehmen      Boolean
  neueKontakteGeknuepft Boolean
  kooperationEntstanden Boolean

  // Qualitativ
  kommentar             String?
  verbesserungsvorschlag String?

  createdAt             DateTime    @default(now())
}

model EventMatch {
  id              String      @id @default(cuid())
  event           Event       @relation(fields: [eventId], references: [id])
  eventId         String

  // Die beiden Unternehmen
  firma1Name      String
  firma1Id        String?
  firma2Name      String
  firma2Id        String?

  // Vermittlung
  vermitteltDurch String?     // Operator-Name
  notiz           String?

  // Nachverfolgung
  folgekontakt    Boolean     @default(false)
  kooperation     Boolean     @default(false)
  kooperationsArt String?     // z.B. "Vertriebspartnerschaft"

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum EventTypNeu {
  pitch_and_meet
  blind_matchmaking
  breakfast_networking
  failure_night
  reverse_networking
  problem_solving
  walk_and_talk
  betriebsbesichtigung
  branchentag
  connect_in_car
  online_webinar
  sonstiges
}

enum EventStatus {
  geplant
  veroeffentlicht
  ausgebucht
  durchgefuehrt
  abgesagt
}

enum EventSprache {
  deutsch
  daenisch
  englisch
  bilingual
  trilingual
}

enum EventZiel {
  matchmaking
  wissenstransfer
  markteintritt
  netzwerk
  kulturverstaendnis
  inspiration
}

enum TeilnehmerStatus {
  angemeldet
  bestaetigt
  erschienen
  abgesagt
  warteliste
}

// ─── SUCCESS STORIES ─────────────────────────────────────────────

model SuccessStory {
  id                  String          @id @default(cuid())

  // Grunddaten
  titel               String
  kurzbeschreibung    String?
  freigabe            StoryFreigabe   @default(intern)
  anonymisiert        Boolean         @default(true)

  // Inhalt (Narrative Struktur)
  ausgangssituation   String?         // Was hat Unternehmen A gesucht?
  herausforderung     String?         // Welche Hürde gab es?
  gesuch              String?         // Was konkret wurde gesucht?
  vermittlungsweg     String?         // Wie kam der Kontakt zustande?
  ergebnis            String          // Was ist entstanden?
  erkenntnisse        String?         // Was können andere daraus lernen?

  // Anonymisierte Versionen (für Marktplatz/Homepage)
  titelAnon           String?         // Titel ohne Firmennamen
  ergebnisAnon        String?         // Ergebnis anonymisiert

  // KI-generierte Content-Varianten
  kiHomepage          String?
  kiLinkedIn          String?
  kiNewsletter        String?

  // Kategorisierung
  branche             String?
  land                Land?
  entstehungsweg      EntstehungsWeg  @default(matchmaking)
  ergebnisTypen       ErgebnisTyp[]

  // Hauptunternehmen (Suchender)
  unternehmen         Unternehmen     @relation(fields: [unternehmenId], references: [id])
  unternehmenId       String

  // Partner (optional, kann anonym bleiben)
  partnerFirmaName    String?
  partnerFirmaId      String?

  // Verknüpfungen (optional)
  anfrageId           String?
  eventId             String?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

enum StoryFreigabe {
  intern              // Nur Dashboard
  anonymisiert        // Öffentlich ohne Firmennamen
  freigegeben         // Öffentlich mit Firmennamen
}

enum EntstehungsWeg {
  matchmaking
  event
  netzwerkkontakt
  empfehlung
  soft_landing
  direktkontakt
}

enum ErgebnisTyp {
  kooperation
  vertriebspartner
  lieferant
  markteintritt
  projekt
  wissenstransfer
  netzwerkaufbau
}

// ─── EVENTS & TEILNAHMEN ─────────────────────────────────────────

model EventTeilnahme {
  id              String      @id @default(cuid())
  eventName       String
  eventDatum      DateTime
  format          EventFormat
  unternehmen     Unternehmen @relation(fields: [unternehmenId], references: [id])
  unternehmenId   String
  rolle           String?     // z.B. "Pitcher", "Gast", "Sponsor"
  notiz           String?
  createdAt       DateTime    @default(now())
}

enum EventFormat {
  pitch_and_meet
  betriebsbesichtigung
  branchentag
  connect_in_car
  netzwerktreffen
  interview
  sonstiges
}

// ─── BRANCHEN & WISSENSBASIS ─────────────────────────────────────

model Branche {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  beschreibung String?
  wissensbasis BranchenWissen[]
  anfragen    Anfrage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BranchenWissen {
  id          String   @id @default(cuid())
  branche     Branche  @relation(fields: [brancheId], references: [id])
  brancheId   String
  frage       String
  frageTyp    FrageTyp
  pflicht     Boolean  @default(false)
  koKriterium Boolean  @default(false)
  quelle      WissensQuelle
  bestaetigt  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

enum WissensQuelle {
  betreiber
  ki_vorschlag
  ki_bestaetigt
}

// ─── ANFRAGEN (ANZEIGEN) ─────────────────────────────────────────

model Anfrage {
  id              String        @id @default(cuid())
  anzeigenId      String        @unique
  richtung        Richtung
  art             AnfrageArt
  branche         Branche       @relation(fields: [brancheId], references: [id])
  brancheId       String
  gesuchteBranche String?

  // Unternehmen-Relation (optional — bestehende Daten bleiben gültig)
  unternehmen     Unternehmen?  @relation(fields: [unternehmenId], references: [id])
  unternehmenId   String?

  // Fallback-Felder (bleiben erhalten für Abwärtskompatibilität)
  firmenname      String
  standort        String
  website         String?
  sprachen        Sprache[]
  beschreibung    String
  ziel            String
  persönlicherTouch String
  mustHaves       String?
  niceToHaves     String?
  reifegrad       Reifegrad

  // ── FUNFACT & PERSÖNLICHE NOTE (anfragebezogen) ───────────────
  funFactFrage        String?       // z.B. "Wie würdet ihr einen Deal feiern?"
  funFactAntwort      String?       // Rohantwort des Unternehmens
  funFactAntwortKI    String?       // KI-verbesserte Version
  kulturHinweis       String?       // interner Hinweis zur Kultur
  gespraechseinstieg  String?       // Vorschlag für ersten Kontakt
  funFactOeffentlich  Boolean       @default(false)  // Im Marktplatz anzeigen?
  gueltigBis      DateTime
  sichtbarkeit    Sichtbarkeit
  status          AnfrageStatus @default(eingehend)
  kontaktTimer    DateTime?
  ansprechpartner String
  email           String
  telefon         String?
  kiAnzeigentext  String?
  kiStrukturiert  Boolean       @default(false)
  frageFormular   Frageformular?
  interessenten   Interessent[]
  reviewOk        Boolean       @default(false)
  reviewNotiz     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum Richtung      { de_dk dk_de }
enum AnfrageArt    { lieferant kunden kooperation vertrieb }
enum Reifegrad     { idee konzept bereit sofort }
enum Sichtbarkeit  { intern anonym oeffentlich }
enum Sprache       { deutsch daenisch englisch }

enum AnfrageStatus {
  eingehend
  aktiv
  interessent_vorhanden
  mehrere_interessenten
  kontakt_laeuft
  vermittelt
  stalled
  pausiert
  archiviert
}

// ─── FRAGEFORMULARE (KI-GENERIERT) ───────────────────────────────

model Frageformular {
  id          String    @id @default(cuid())
  anfrage     Anfrage   @relation(fields: [anfrageId], references: [id])
  anfrageId   String    @unique
  fragen      Frage[]
  aktiv       Boolean   @default(true)
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Frage {
  id            String        @id @default(cuid())
  formular      Frageformular @relation(fields: [formularId], references: [id])
  formularId    String
  reihenfolge   Int
  text          String
  typ           FrageTyp
  pflicht       Boolean       @default(true)
  koKriterium   Boolean       @default(false)
  koWert        String?
  optionen      String[]
  quelle        FrageQuelle
  kiVorschlag   Boolean       @default(false)
  bestaetigt    Boolean       @default(true)
  antworten     Antwort[]
  createdAt     DateTime      @default(now())
}

enum FrageTyp {
  zahl
  text_kurz
  text_lang
  ja_nein
  auswahl_single
  auswahl_multi
  skala
  datum
}

enum FrageQuelle {
  anzeige
  ki_schicht2
  betreiber
}

// ─── INTERESSENTEN ───────────────────────────────────────────────

model Interessent {
  id              String              @id @default(cuid())
  anfrage         Anfrage             @relation(fields: [anfrageId], references: [id])
  anfrageId       String

  // Unternehmen-Relation (optional — bestehende Daten bleiben gültig)
  unternehmen     Unternehmen?        @relation(fields: [unternehmenId], references: [id])
  unternehmenId   String?

  // Fallback-Felder (bleiben erhalten für Abwärtskompatibilität)
  firmenname      String
  ansprechpartner String
  email           String
  telefon         String?
  antworten       Antwort[]
  status          InteressentStatus   @default(neu)
  freigegeben     Boolean             @default(false)
  kontaktDatum    DateTime?
  matchScore      Int?
  matchBewertung  Json?
  kiBewertungDatum DateTime?
  feedbackSuchender   FeedbackStatus  @default(ausstehend)
  feedbackInteressent FeedbackStatus  @default(ausstehend)
  reminder5Gesendet   Boolean         @default(false)
  reminder10Gesendet  Boolean         @default(false)
  stalledGesetzt      Boolean         @default(false)
  notiz           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

enum InteressentStatus {
  neu
  freigegeben
  kontakt_laeuft
  feedback_ausstehend
  erfolgreich
  spam
  unqualifiziert
  stalled
  abgelehnt
}

enum FeedbackStatus {
  ausstehend
  kontakt_hergestellt
  kein_kontakt
  erfolg
  kein_match
}

// ─── FORMULAR-ANTWORTEN ──────────────────────────────────────────

model Antwort {
  id            String      @id @default(cuid())
  interessent   Interessent @relation(fields: [interessentId], references: [id])
  interessentId String
  frage         Frage       @relation(fields: [frageId], references: [id])
  frageId       String
  wert          String
  koVerletzt    Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

// ─── BLACKLIST ───────────────────────────────────────────────────

model Blacklist {
  id          String   @id @default(cuid())
  email       String   @unique
  firmenname  String?
  grund       BlacklistGrund
  notiz       String?
  createdAt   DateTime @default(now())
}

enum BlacklistGrund {
  spam
  kein_kontakt
  falsche_angaben
  unernst
}

// ─── E-MAIL LOG ──────────────────────────────────────────────────

model EmailLog {
  id          String   @id @default(cuid())
  an          String
  betreff     String
  typ         EmailTyp
  anfrageId   String?
  interessentId String?
  erfolg      Boolean
  createdAt   DateTime @default(now())
}

enum EmailTyp {
  bestaetigung_interessent
  benachrichtigung_betreiber
  kontaktdaten_suchender
  kontaktdaten_interessent
  reminder_tag5
  reminder_tag10
  stalled_alarm
  ablauf_warnung
}

// ─── NETZWERK & KONTAKTE ──────────────────────────────────────

model Netzwerkkontakt {
  id                  String              @id @default(cuid())

  // Person / Organisation
  name                String
  organisation        String?
  position            String?             // z.B. "Geschäftsführer", "Netzwerkmanager"
  kategorie           KontaktKategorie
  land                Land
  region              String?             // z.B. "Schleswig-Holstein", "Süddänemark"
  branche             String?

  // Kontaktdaten
  email               String?
  telefon             String?
  linkedin            String?
  website             String?

  // Netzwerkdaten
  quelle              String?             // Wie gefunden (Event, Empfehlung, etc.)
  erstkontakt         DateTime?
  letzterKontakt      DateTime?
  aktivitaetsStatus   AktivitaetsStatus   @default(aktiv)
  interneNotiz        String?

  // Netzwerkwert (intern, nie öffentlich)
  netzwerkWert        Int                 @default(0)  // 0–100

  // Beziehungen
  empfehlungen        Empfehlung[]        @relation("EmpfehlerKontakt")
  kontaktHistorie     KontaktHistorie[]

  // Optional: Verknüpfung zu einem Unternehmen im System
  unternehmenId       String?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model Empfehlung {
  id                  String              @id @default(cuid())

  // Wer empfiehlt?
  empfehler           Netzwerkkontakt     @relation("EmpfehlerKontakt", fields: [empfehlerId], references: [id])
  empfehlerId         String

  // Was/Wen wird empfohlen?
  empfohlenesUnternehmen Unternehmen?     @relation("EmpfehlungUnternehmen", fields: [unternehmenId], references: [id])
  unternehmenId       String?
  empfohleneName      String              // Name des empfohlenen (Fallback)

  // Details
  datum               DateTime            @default(now())
  kontext             String?             // Warum die Empfehlung?
  status              EmpfehlungsStatus   @default(offen)
  ergebnis            String?             // Was ist daraus geworden?
  erfolgreich         Boolean             @default(false)

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model KontaktHistorie {
  id                  String              @id @default(cuid())

  kontakt             Netzwerkkontakt     @relation(fields: [kontaktId], references: [id])
  kontaktId           String

  typ                 HistorieTyp
  datum               DateTime
  notiz               String
  ergebnis            String?
  naechsteAktion      String?
  naechsteAktionAm    DateTime?
  erledigt            Boolean             @default(false)
  eingetragenVon      String?             // Operator-Name

  createdAt           DateTime            @default(now())
}

enum KontaktKategorie {
  unternehmer
  verband
  kammer
  wirtschaftsfoerderung
  kommune
  dienstleister
  berater
  investor
  journalist
  politik
  sonstiges
}

enum AktivitaetsStatus {
  aktiv
  passiv
  ruhend
  inaktiv
}

enum EmpfehlungsStatus {
  offen
  kontaktiert
  in_pruefung
  angenommen
  abgelehnt
  erfolgreich
}

enum HistorieTyp {
  telefonat
  meeting
  email
  event
  nachricht
  wiedervorlage
  notiz
}
// ─── KULTUR & WISSEN ──────────────────────────────────────────

model KulturMoment {
  id              String          @id @default(cuid())

  // Grunddaten
  titel           String
  kategorie       KulturKategorie
  land            KulturLand
  originalSprache String?         // Originalzitat (z.B. dänisch)
  status          WissenStatus    @default(entwurf)

  // Inhalt
  ausgangssituation String?
  aussage           String?       // Was wurde gesagt?
  interpretation    String?       // Wie wird es (falsch) verstanden?
  bedeutung         String?       // Was ist tatsächlich gemeint?
  lernmoment        String        // Die zentrale Erkenntnis

  // Ton & Sichtbarkeit
  ton             KulturTon       @default(neutral)
  oeffentlich     Boolean         @default(false)

  // Nutzungs-Tracking
  verwendetCount  Int             @default(0)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Grenzgeschichte {
  id              String          @id @default(cuid())

  titel           String
  typ             GeschichteTyp
  kategorie       KulturKategorie
  status          WissenStatus    @default(entwurf)

  // Inhalt
  situation       String
  verlauf         String?
  erkenntnis      String
  oeffentlich     Boolean         @default(false)

  // Beteiligte (anonymisierbar)
  beteiligteFirma1 String?
  beteiligteFirma2 String?
  anonymisiert     Boolean        @default(true)

  // Verwendung
  verwendetCount  Int             @default(0)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum KulturKategorie {
  kommunikation
  meetings
  hierarchien
  entscheidungen
  humor
  vertrieb
  kooperation
  verhandlungen
  sprache
  sonstiges
}

enum KulturLand {
  deutschland
  daenemark
  beide
}

enum WissenStatus {
  entwurf
  geprueft
  veroeffentlicht
  archiviert
}

enum KulturTon {
  humorvoll
  ernst
  neutral
  ueberraschend
}

enum GeschichteTyp {
  missverstaendnis
  erfolgsgeschichte
  ueberraschung
  erkenntnis
}
